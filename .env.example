# Application
NODE_ENV=production
PORT=8080
APP_URL=https://your-bugflow-domain.up.railway.app
CORS_ORIGIN=https://your-bugflow-domain.up.railway.app

# Railway PostgreSQL. Reference the PostgreSQL service variable in Railway.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Resend. Create a verified sender domain in Resend before enabling delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=updates@example.com

# Railway Storage Bucket. Add these via Railway Bucket variable references.
BUCKET=${{BugFlowAttachments.BUCKET}}
ACCESS_KEY_ID=${{BugFlowAttachments.ACCESS_KEY_ID}}
SECRET_ACCESS_KEY=${{BugFlowAttachments.SECRET_ACCESS_KEY}}
REGION=${{BugFlowAttachments.REGION}}
ENDPOINT=${{BugFlowAttachments.ENDPOINT}}
# Only set true for older buckets whose Railway credentials explicitly request path-style access.
S3_FORCE_PATH_STYLE=false

# Seed this only during initial setup, then remove it from the service variables.
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
